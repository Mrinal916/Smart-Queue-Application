# SmartQueue Environment Configuration Template
# Copy this file to .env and configure with your local credentials

# Database Configuration (PostgreSQL)
DB_URL=jdbc:postgresql://localhost:5432/smartqueue
DB_USERNAME=smartqueue
DB_PASSWORD=choose-a-local-password

# Redis Cache Configuration
REDIS_HOST=localhost
REDIS_PORT=6379

# Security Configuration
JWT_SECRET=change-this-local-jwt-secret-2026-08-06-not-for-production
SERVER_PORT=8080

# Notification Service (SMTP / Email)
TwilioSettings__FromEmail=your_email@example.com
TwilioSettings__SmtpUsername=your_email@example.com
TwilioSettings__SmtpPassword=your_smtp_app_password
